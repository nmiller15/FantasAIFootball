@model HistoryViewModel
@if (Model.Data.Total == 0)
{
    <partial name="_EmptyCalls" model="Model.Data.DatabaseExists" />
}
else
{
    <div class="section-title"><h2>Call history</h2><span>@Model.Data.Total.ToString("N0") CALLS · EXPAND TO VIEW ARGUMENTS</span></div>
    <div class="panel call-list">
        @foreach (var call in Model.Data.Calls)
        {
            <details class="call">
                <summary><span class="call-name">@call.Name</span><time>@DashboardFormatting.Time(call.Timestamp)</time><span class="chevron" aria-hidden="true"></span></summary>
                <div class="call-arguments"><span>ARGUMENTS</span><pre>@(string.IsNullOrWhiteSpace(call.Arguments) ? "(none)" : call.Arguments)</pre></div>
            </details>
        }
    </div>
    <nav class="pagination" aria-label="Call history pages">
        @if (Model.Data.Page > 1)
        {
            <a asp-action="History" asp-route-leagueId="@Model.Id" asp-route-period="@Model.Data.Period.Query" asp-route-page="@(Model.Data.Page - 1)">← Newer</a>
        }
        <span>PAGE @Model.Data.Page.ToString("N0") OF @Model.Data.PageCount.ToString("N0")</span>
        @if (Model.Data.Page < Model.Data.PageCount)
        {
            <a asp-action="History" asp-route-leagueId="@Model.Id" asp-route-period="@Model.Data.Period.Query" asp-route-page="@(Model.Data.Page + 1)">Older →</a>
        }
    </nav>
}

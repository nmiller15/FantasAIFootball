@model ScheduledRun
@{
    var status = !Model.StatusAvailable ? "STATUS UNAVAILABLE" : Model.ExecutedAt is not null ? "COMPLETED"
        : Model.Body is not null ? "AWAITING DELIVERY" : "SCHEDULED";
    var title = !string.IsNullOrWhiteSpace(Model.Notes) ? Model.Notes
        : !string.IsNullOrWhiteSpace(Model.Subject) && !string.IsNullOrWhiteSpace(Model.Body)
            ? Model.Subject : "Scheduled check";
    var runClass = !Model.StatusAvailable || Model.ExecutedAt is not null ? "" : Model.Body is null ? " run-pending" : " run-undelivered";
}
<details class="call run-item@runClass">
    <summary>
        <span class="call-name">
            @title
            @if (Model.StatusAvailable && Model.ExecutedAt is null)
            {
                <span class="run-status">@(Model.Body is null ? "NOT RUN YET" : "AWAITING DELIVERY")</span>
            }
        </span>
        <time>Scheduled · @DashboardFormatting.Time(Model.ScheduledAt)</time><span class="chevron" aria-hidden="true"></span>
    </summary>
    <div class="call-arguments run-details">
        <span>@status</span>
        @if (Model.ExecutedAt is not null)
        {
            <p>Executed · @DashboardFormatting.Time(Model.ExecutedAt)</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p>Notes · @Model.Notes</p>
        }
        @if (Model.StatusAvailable && Model.ExecutedAt is null && Model.Body is null)
        {
            <form class="run-note-edit" asp-controller="Dashboard" asp-action="EditRunNotes" asp-route-leagueId="@ViewContext.RouteData.Values["leagueId"]" asp-route-key="@Model.Key" method="post">
                <input type="hidden" name="period" value="@ViewData["RunPeriod"]">
                <input type="hidden" name="returnTo" value="@ViewContext.RouteData.Values["action"]">
                <input type="hidden" name="page" value="@Context.Request.Query["page"]">
                <label for="run-note-@Model.Key">Note for the run</label>
                <textarea id="run-note-@Model.Key" name="notes" rows="3" maxlength="2000" placeholder="Optional instructions for this check">@Model.Notes</textarea>
                <button type="submit">Save note</button>
            </form>
        }
        @if (Model.Subject is not null)
        {
            <p>Subject · @Model.Subject</p>
        }
        @if (Model.Body is not null)
        {
            <a class="report-link" asp-controller="Dashboard" asp-action="Report" asp-route-leagueId="@ViewContext.RouteData.Values["leagueId"]" asp-route-key="@Model.Key" target="_blank" rel="noopener noreferrer">Open full-screen report ↗</a>
            <iframe title="Report: @title" sandbox="" referrerpolicy="no-referrer" srcdoc="@Model.Body"></iframe>
        }
        else
        {
            <p>No report saved for this run.</p>
        }
    </div>
</details>
